# Dental Voice AI - Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Configuration
PROJECT_NAME=Dental Voice AI - Multi-Office Factory
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production
WEBHOOK_SECRET=your-webhook-secret-here

# VAPI Integration (Required for voice AI features)
VAPI_API_KEY=your-vapi-api-key-here

# Database Configuration (Required for production)
SUPABASE_URL=your-supabase-url-here
SUPABASE_KEY=your-supabase-key-here

# CORS Configuration (Comma-separated list of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://yourdomain.com"]

# AI Configuration
FAQ_SIMILARITY_THRESHOLD=0.7
INTENT_CONFIDENCE_THRESHOLD=0.3

# Performance Configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
REQUEST_TIMEOUT=30

# Feature Flags
ENABLE_SEMANTIC_MATCHING=true
ENABLE_ENTITY_EXTRACTION=true
ENABLE_TENANT_SPECIFIC_FAQS=true

# Logging Configuration
LOG_LEVEL=INFO

# Business Configuration
DEFAULT_BUSINESS_START_HOUR=9
DEFAULT_BUSINESS_END_HOUR=17
MAX_FAQ_KEYWORDS=10
MAX_FAQ_LENGTH=10000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
