# Healthcare Voice AI - Environment Configuration Template
# Copy this file to .env and update with your actual values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=true

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Application version
VERSION=1.0.0

# Project name
PROJECT_NAME=Healthcare Voice AI

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Supabase configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Database connection settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT configuration
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
PASSWORD_HASH_ALGORITHM=bcrypt
PASSWORD_HASH_ROUNDS=12

# CORS configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# HTTPS enforcement
ENFORCE_HTTPS=false
HSTS_MAX_AGE=31536000

# =============================================================================
# EXTERNAL API CONFIGURATION
# =============================================================================

# VAPI (Voice AI) configuration
VAPI_API_KEY=your_vapi_api_key_here
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret_here

# Google Calendar integration
GOOGLE_CALENDAR_ID=your_google_calendar_id_here
GOOGLE_CALENDAR_CREDENTIALS_FILE=path/to/google_credentials.json

# Email configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_USE_TLS=true

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20

# Cache settings
CACHE_TTL_SECONDS=3600
CACHE_PREFIX=healthcare_voice_ai

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# File upload settings
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,jpg,jpeg,png
UPLOAD_DIRECTORY=uploads
TEMP_DIRECTORY=temp
QUARANTINE_DIRECTORY=quarantine

# File security
SCAN_UPLOADS_FOR_MALWARE=true
QUARANTINE_SUSPICIOUS_FILES=true

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Prometheus metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana configuration
GRAFANA_ENABLED=true
GRAFANA_PORT=3000
GRAFANA_PASSWORD=your_grafana_password_here

# Logging
LOG_TO_FILE=true
LOG_FILE_PATH=logs/healthcare_voice_ai.log
LOG_ROTATION_SIZE_MB=10
LOG_ROTATION_BACKUP_COUNT=5

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================

# SSL settings
SSL_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/healthcare-voice-ai.crt
SSL_KEY_PATH=/etc/ssl/private/healthcare-voice-ai.key

# Let's Encrypt
LETSENCRYPT_EMAIL=admin@yourdomain.com
LETSENCRYPT_DOMAIN=yourdomain.com

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker settings
DOCKER_REGISTRY=your_registry.com
DOCKER_IMAGE_TAG=latest
DOCKER_BUILD_CONTEXT=.

# Container settings
CONTAINER_MEMORY_LIMIT=1g
CONTAINER_CPU_LIMIT=1.0

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development settings
HOT_RELOAD=true
AUTO_RELOAD=true
RELOAD_DIRS=src,frontend/src

# Testing
TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db
TEST_REDIS_URL=redis://localhost:6379/1

# =============================================================================
# PRODUCTION CONFIGURATION
# =============================================================================

# Production settings
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_CONNECTIONS=1000
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100

# Performance
KEEP_ALIVE_TIMEOUT=5
KEEP_ALIVE_MAX=100

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature toggles
FEATURE_VOICE_AI=true
FEATURE_CALENDAR_INTEGRATION=true
FEATURE_FILE_UPLOAD=true
FEATURE_AUDIT_LOGGING=true
FEATURE_RATE_LIMITING=true
FEATURE_SSL_ENFORCEMENT=false

# =============================================================================
# INTEGRATION CONFIGURATION
# =============================================================================

# Webhook endpoints
WEBHOOK_BASE_URL=https://yourdomain.com
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_RETRY_ATTEMPTS=3

# API versioning
API_VERSION=v1
API_PREFIX=/api

# =============================================================================
# COMPLIANCE CONFIGURATION
# =============================================================================

# HIPAA compliance
HIPAA_COMPLIANCE_MODE=true
AUDIT_LOG_ENABLED=true
DATA_ENCRYPTION_ENABLED=true
ACCESS_LOG_ENABLED=true

# Data retention
DATA_RETENTION_DAYS=2555  # 7 years for HIPAA
AUDIT_LOG_RETENTION_DAYS=2555

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================

# Notification settings
NOTIFICATIONS_ENABLED=true
NOTIFICATION_EMAIL_FROM=noreply@yourdomain.com
NOTIFICATION_EMAIL_TO=admin@yourdomain.com

# Alert thresholds
CPU_ALERT_THRESHOLD=80
MEMORY_ALERT_THRESHOLD=85
DISK_ALERT_THRESHOLD=90
ERROR_RATE_ALERT_THRESHOLD=5

# =============================================================================
# CUSTOM CONFIGURATION
# =============================================================================

# Add your custom environment variables here
# CUSTOM_SETTING_1=value1
# CUSTOM_SETTING_2=value2
